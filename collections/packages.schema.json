{
  "$ref": "#/definitions/packages",
  "definitions": {
    "packages": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "published",
            "offline"
          ],
          "default": "published"
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "editorial",
            "api",
            "sync",
            "ai"
          ],
          "default": "editorial"
        },
        "sample": {
          "type": "boolean"
        },
        "verification": {
          "type": "object",
          "properties": {
            "verifiedBy": {
              "type": "string",
              "minLength": 1
            },
            "verifiedAt": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "errorMessage": {
                "pattern": "日期格式必须为 YYYY-MM-DD"
              }
            },
            "source": {
              "type": "object",
              "properties": {
                "zh-CN": {
                  "type": "string",
                  "minLength": 1
                },
                "en": {
                  "type": "string",
                  "minLength": 1
                },
                "zh-Hant": {
                  "type": "string",
                  "minLength": 1
                },
                "ja": {
                  "type": "string",
                  "minLength": 1
                },
                "ko": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "sourceUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "verifiedBy",
            "verifiedAt",
            "source"
          ],
          "additionalProperties": false
        },
        "updatedAt": {
          "$ref": "#/definitions/packages/properties/verification/properties/verifiedAt"
        },
        "translations": {
          "type": "object",
          "properties": {
            "zh-CN": {
              "type": "string",
              "enum": [
                "source",
                "machine",
                "reviewed"
              ]
            },
            "en": {
              "type": "string",
              "enum": [
                "source",
                "machine",
                "reviewed"
              ]
            },
            "zh-Hant": {
              "type": "string",
              "enum": [
                "source",
                "machine",
                "reviewed"
              ]
            },
            "ja": {
              "type": "string",
              "enum": [
                "source",
                "machine",
                "reviewed"
              ]
            },
            "ko": {
              "type": "string",
              "enum": [
                "source",
                "machine",
                "reviewed"
              ]
            }
          },
          "additionalProperties": false
        },
        "resort": {
          "type": "string",
          "minLength": 1
        },
        "stay": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "$ref": "#/definitions/packages/properties/verification/properties/source"
        },
        "summary": {
          "$ref": "#/definitions/packages/properties/verification/properties/source"
        },
        "days": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "level": {
          "type": "string",
          "enum": [
            "beginner",
            "intermediate",
            "advanced"
          ]
        },
        "includes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/packages/properties/verification/properties/source"
          }
        },
        "excludes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/packages/properties/verification/properties/source"
          }
        },
        "highlights": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/packages/properties/verification/properties/source"
          },
          "maxItems": 3
        },
        "price": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "currency": {
              "type": "string",
              "const": "CNY"
            },
            "unit": {
              "type": "string",
              "enum": [
                "night",
                "person",
                "package"
              ]
            }
          },
          "required": [
            "amount",
            "currency",
            "unit"
          ],
          "additionalProperties": false
        },
        "departures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "$ref": "#/definitions/packages/properties/verification/properties/verifiedAt"
              },
              "priceCny": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "seatsLeft": {
                "type": "integer",
                "minimum": 0
              },
              "status": {
                "type": "string",
                "enum": [
                  "open",
                  "limited",
                  "full"
                ]
              }
            },
            "required": [
              "date"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "faq": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "q": {
                "$ref": "#/definitions/packages/properties/verification/properties/source"
              },
              "a": {
                "$ref": "#/definitions/packages/properties/verification/properties/source"
              }
            },
            "required": [
              "q",
              "a"
            ],
            "additionalProperties": false
          }
        },
        "cover": {
          "type": "string"
        },
        "booking": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "productId": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "priceSyncedAt": {
              "type": "string"
            },
            "mpAppId": {
              "type": "string"
            },
            "mpPath": {
              "type": "string"
            }
          },
          "required": [
            "provider"
          ],
          "additionalProperties": false
        },
        "availability": {
          "type": "object",
          "properties": {
            "blackoutDates": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/packages/properties/verification/properties/verifiedAt"
              },
              "default": []
            },
            "availableMonths": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              }
            },
            "closedWeekdays": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              }
            },
            "leadDays": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "slug",
        "sample",
        "verification",
        "updatedAt",
        "resort",
        "name",
        "summary",
        "days",
        "level",
        "includes",
        "excludes",
        "highlights",
        "faq"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}