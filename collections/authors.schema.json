{
  "$ref": "#/definitions/authors",
  "definitions": {
    "authors": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "published",
            "offline"
          ],
          "default": "published"
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "editorial",
            "api",
            "sync",
            "ai"
          ],
          "default": "editorial"
        },
        "sample": {
          "type": "boolean"
        },
        "verification": {
          "type": "object",
          "properties": {
            "verifiedBy": {
              "type": "string",
              "minLength": 1
            },
            "verifiedAt": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "errorMessage": {
                "pattern": "日期格式必须为 YYYY-MM-DD"
              }
            },
            "source": {
              "type": "object",
              "properties": {
                "zh-CN": {
                  "type": "string",
                  "minLength": 1
                },
                "en": {
                  "type": "string",
                  "minLength": 1
                },
                "zh-Hant": {
                  "type": "string",
                  "minLength": 1
                },
                "ja": {
                  "type": "string",
                  "minLength": 1
                },
                "ko": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "sourceUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "verifiedBy",
            "verifiedAt",
            "source"
          ],
          "additionalProperties": false
        },
        "updatedAt": {
          "$ref": "#/definitions/authors/properties/verification/properties/verifiedAt"
        },
        "translations": {
          "type": "object",
          "properties": {
            "zh-CN": {
              "type": "string",
              "enum": [
                "source",
                "machine",
                "reviewed"
              ]
            },
            "en": {
              "type": "string",
              "enum": [
                "source",
                "machine",
                "reviewed"
              ]
            },
            "zh-Hant": {
              "type": "string",
              "enum": [
                "source",
                "machine",
                "reviewed"
              ]
            },
            "ja": {
              "type": "string",
              "enum": [
                "source",
                "machine",
                "reviewed"
              ]
            },
            "ko": {
              "type": "string",
              "enum": [
                "source",
                "machine",
                "reviewed"
              ]
            }
          },
          "additionalProperties": false
        },
        "name": {
          "$ref": "#/definitions/authors/properties/verification/properties/source"
        },
        "role": {
          "$ref": "#/definitions/authors/properties/verification/properties/source"
        },
        "bio": {
          "$ref": "#/definitions/authors/properties/verification/properties/source"
        },
        "credentials": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/authors/properties/verification/properties/source"
          },
          "default": []
        },
        "avatar": {
          "type": "string"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "label",
              "url"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "slug",
        "sample",
        "verification",
        "updatedAt",
        "name",
        "role",
        "bio"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}