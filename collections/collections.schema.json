{
  "$ref": "#/definitions/collections",
  "definitions": {
    "collections": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "published",
            "offline"
          ],
          "default": "published"
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "editorial",
            "api",
            "sync",
            "ai"
          ],
          "default": "editorial"
        },
        "sample": {
          "type": "boolean"
        },
        "verification": {
          "type": "object",
          "properties": {
            "verifiedBy": {
              "type": "string",
              "minLength": 1
            },
            "verifiedAt": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "errorMessage": {
                "pattern": "日期格式必须为 YYYY-MM-DD"
              }
            },
            "source": {
              "type": "object",
              "properties": {
                "zh-CN": {
                  "type": "string",
                  "minLength": 1
                },
                "en": {
                  "type": "string",
                  "minLength": 1
                },
                "zh-Hant": {
                  "type": "string",
                  "minLength": 1
                },
                "ja": {
                  "type": "string",
                  "minLength": 1
                },
                "ko": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "sourceUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "verifiedBy",
            "verifiedAt",
            "source"
          ],
          "additionalProperties": false
        },
        "updatedAt": {
          "$ref": "#/definitions/collections/properties/verification/properties/verifiedAt"
        },
        "translations": {
          "type": "object",
          "properties": {
            "zh-CN": {
              "type": "string",
              "enum": [
                "source",
                "machine",
                "reviewed"
              ]
            },
            "en": {
              "type": "string",
              "enum": [
                "source",
                "machine",
                "reviewed"
              ]
            },
            "zh-Hant": {
              "type": "string",
              "enum": [
                "source",
                "machine",
                "reviewed"
              ]
            },
            "ja": {
              "type": "string",
              "enum": [
                "source",
                "machine",
                "reviewed"
              ]
            },
            "ko": {
              "type": "string",
              "enum": [
                "source",
                "machine",
                "reviewed"
              ]
            }
          },
          "additionalProperties": false
        },
        "title": {
          "$ref": "#/definitions/collections/properties/verification/properties/source"
        },
        "directAnswer": {
          "$ref": "#/definitions/collections/properties/verification/properties/source"
        },
        "filter": {
          "type": "object",
          "properties": {
            "resortSlugs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "staySlugs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "packageSlugs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          },
          "additionalProperties": false
        },
        "highlights": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/collections/properties/verification/properties/source"
          },
          "maxItems": 3
        },
        "faq": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "q": {
                "$ref": "#/definitions/collections/properties/verification/properties/source"
              },
              "a": {
                "$ref": "#/definitions/collections/properties/verification/properties/source"
              }
            },
            "required": [
              "q",
              "a"
            ],
            "additionalProperties": false
          }
        },
        "cover": {
          "type": "string"
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "slug",
        "sample",
        "verification",
        "updatedAt",
        "title",
        "directAnswer",
        "filter",
        "highlights",
        "faq"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}