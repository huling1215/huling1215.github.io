{
  "$ref": "#/definitions/stays",
  "definitions": {
    "stays": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "published",
            "offline"
          ],
          "default": "published"
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "editorial",
            "api",
            "sync",
            "ai"
          ],
          "default": "editorial"
        },
        "sample": {
          "type": "boolean"
        },
        "verification": {
          "type": "object",
          "properties": {
            "verifiedBy": {
              "type": "string",
              "minLength": 1
            },
            "verifiedAt": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "errorMessage": {
                "pattern": "日期格式必须为 YYYY-MM-DD"
              }
            },
            "source": {
              "type": "object",
              "properties": {
                "zh-CN": {
                  "type": "string",
                  "minLength": 1
                },
                "en": {
                  "type": "string",
                  "minLength": 1
                },
                "zh-Hant": {
                  "type": "string",
                  "minLength": 1
                },
                "ja": {
                  "type": "string",
                  "minLength": 1
                },
                "ko": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "sourceUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "verifiedBy",
            "verifiedAt",
            "source"
          ],
          "additionalProperties": false
        },
        "updatedAt": {
          "$ref": "#/definitions/stays/properties/verification/properties/verifiedAt"
        },
        "translations": {
          "type": "object",
          "properties": {
            "zh-CN": {
              "type": "string",
              "enum": [
                "source",
                "machine",
                "reviewed"
              ]
            },
            "en": {
              "type": "string",
              "enum": [
                "source",
                "machine",
                "reviewed"
              ]
            },
            "zh-Hant": {
              "type": "string",
              "enum": [
                "source",
                "machine",
                "reviewed"
              ]
            },
            "ja": {
              "type": "string",
              "enum": [
                "source",
                "machine",
                "reviewed"
              ]
            },
            "ko": {
              "type": "string",
              "enum": [
                "source",
                "machine",
                "reviewed"
              ]
            }
          },
          "additionalProperties": false
        },
        "resort": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "$ref": "#/definitions/stays/properties/verification/properties/source"
        },
        "summary": {
          "$ref": "#/definitions/stays/properties/verification/properties/source"
        },
        "address": {
          "$ref": "#/definitions/stays/properties/verification/properties/source"
        },
        "coords": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lng": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "lat",
            "lng"
          ],
          "additionalProperties": false
        },
        "starRating": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 1,
              "maximum": 5
            },
            {
              "type": "null"
            }
          ]
        },
        "checkIn": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "errorMessage": {
            "pattern": "时间格式必须为 HH:mm"
          }
        },
        "checkOut": {
          "$ref": "#/definitions/stays/properties/checkIn"
        },
        "mealPlan": {
          "type": "string",
          "enum": [
            "room_only",
            "breakfast",
            "half_board",
            "full_board",
            "all_inclusive"
          ]
        },
        "cancellation": {
          "$ref": "#/definitions/stays/properties/verification/properties/source"
        },
        "villageDistanceM": {
          "type": "integer",
          "minimum": 0
        },
        "skiInOut": {
          "type": "boolean"
        },
        "liftDistanceM": {
          "type": "integer",
          "minimum": 0
        },
        "price": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "currency": {
              "type": "string",
              "const": "CNY"
            },
            "unit": {
              "type": "string",
              "enum": [
                "night",
                "person",
                "package"
              ]
            }
          },
          "required": [
            "amount",
            "currency",
            "unit"
          ],
          "additionalProperties": false
        },
        "rooms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "$ref": "#/definitions/stays/properties/verification/properties/source"
              },
              "areaSqm": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "maxGuests": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "priceCny": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "name",
              "areaSqm",
              "maxGuests",
              "priceCny"
            ],
            "additionalProperties": false
          }
        },
        "amenities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ski_locker",
              "onsen",
              "kids_club",
              "shuttle",
              "equipment_rental",
              "english_front_desk",
              "chinese_staff",
              "drying_room",
              "breakfast",
              "spa",
              "gym",
              "wifi"
            ]
          }
        },
        "kidsClub": {
          "type": "boolean"
        },
        "highlights": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/stays/properties/verification/properties/source"
          },
          "maxItems": 3
        },
        "faq": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "q": {
                "$ref": "#/definitions/stays/properties/verification/properties/source"
              },
              "a": {
                "$ref": "#/definitions/stays/properties/verification/properties/source"
              }
            },
            "required": [
              "q",
              "a"
            ],
            "additionalProperties": false
          }
        },
        "cover": {
          "type": "string"
        },
        "gallery": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "booking": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "productId": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "priceSyncedAt": {
              "type": "string"
            },
            "mpAppId": {
              "type": "string"
            },
            "mpPath": {
              "type": "string"
            }
          },
          "required": [
            "provider"
          ],
          "additionalProperties": false
        },
        "availability": {
          "type": "object",
          "properties": {
            "blackoutDates": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/stays/properties/verification/properties/verifiedAt"
              },
              "default": []
            },
            "availableMonths": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              }
            },
            "closedWeekdays": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              }
            },
            "leadDays": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "slug",
        "sample",
        "verification",
        "updatedAt",
        "resort",
        "name",
        "summary",
        "skiInOut",
        "liftDistanceM",
        "price",
        "rooms",
        "amenities",
        "kidsClub",
        "highlights",
        "faq"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}