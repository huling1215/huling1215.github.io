{
  "$ref": "#/definitions/regions",
  "definitions": {
    "regions": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "published",
            "offline"
          ],
          "default": "published"
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "editorial",
            "api",
            "sync",
            "ai"
          ],
          "default": "editorial"
        },
        "sample": {
          "type": "boolean"
        },
        "verification": {
          "type": "object",
          "properties": {
            "verifiedBy": {
              "type": "string",
              "minLength": 1
            },
            "verifiedAt": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "errorMessage": {
                "pattern": "日期格式必须为 YYYY-MM-DD"
              }
            },
            "source": {
              "type": "object",
              "properties": {
                "zh-CN": {
                  "type": "string",
                  "minLength": 1
                },
                "en": {
                  "type": "string",
                  "minLength": 1
                },
                "zh-Hant": {
                  "type": "string",
                  "minLength": 1
                },
                "ja": {
                  "type": "string",
                  "minLength": 1
                },
                "ko": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "sourceUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "verifiedBy",
            "verifiedAt",
            "source"
          ],
          "additionalProperties": false
        },
        "updatedAt": {
          "$ref": "#/definitions/regions/properties/verification/properties/verifiedAt"
        },
        "translations": {
          "type": "object",
          "properties": {
            "zh-CN": {
              "type": "string",
              "enum": [
                "source",
                "machine",
                "reviewed"
              ]
            },
            "en": {
              "type": "string",
              "enum": [
                "source",
                "machine",
                "reviewed"
              ]
            },
            "zh-Hant": {
              "type": "string",
              "enum": [
                "source",
                "machine",
                "reviewed"
              ]
            },
            "ja": {
              "type": "string",
              "enum": [
                "source",
                "machine",
                "reviewed"
              ]
            },
            "ko": {
              "type": "string",
              "enum": [
                "source",
                "machine",
                "reviewed"
              ]
            }
          },
          "additionalProperties": false
        },
        "country": {
          "type": "string",
          "enum": [
            "china",
            "japan",
            "korea",
            "kazakhstan",
            "switzerland",
            "france",
            "austria",
            "italy",
            "canada",
            "usa",
            "new-zealand",
            "australia",
            "chile"
          ]
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "$ref": "#/definitions/regions/properties/verification/properties/source"
        },
        "intro": {
          "$ref": "#/definitions/regions/properties/verification/properties/source"
        },
        "directAnswer": {
          "$ref": "#/definitions/regions/properties/verification/properties/source"
        },
        "faq": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "q": {
                "$ref": "#/definitions/regions/properties/verification/properties/source"
              },
              "a": {
                "$ref": "#/definitions/regions/properties/verification/properties/source"
              }
            },
            "required": [
              "q",
              "a"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "cover": {
          "type": "string"
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "slug",
        "sample",
        "verification",
        "updatedAt",
        "country",
        "region",
        "name",
        "intro",
        "directAnswer"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}