key":"season","attributeKey":"season","widget":"select","order":4},{"key":"nightDiving","attributeKey":"nightDiving","widget":"boolean","order":5}],"compare":[{"attributeKey":"maxDepthM","order":1},{"attributeKey":"visibilityM","order":2},{"attributeKey":"waterTempC","order":3},{"attributeKey":"diveSites","order":4},{"attributeKey":"currentLevel","order":5},{"attributeKey":"certLevel","order":6},{"attributeKey":"entryType","order":7},{"attributeKey":"season","order":8},{"attributeKey":"nightDiving","order":9}],"card":{"statAttributeKeys":["maxDepthM","visibilityM","diveSites","season"],"badgeAttributeKeys":["certLevel"],"showCoords":true,"highlightLimit":3},"features":{"passes":false,"compare":true}},"examples":[{"slug":"sipadan","status":"published","sourceType":"editorial","sample":true,"featured":true,"updatedAt":"2026-11-22","verification":{"verifiedBy":"diving-editorial","verifiedAt":"2026-11-20","source":{"zh-CN":"沙巴公园局每日上岛配额公告与仙本那潜店实测水文记录核验","en":"Sabah Parks Daily Permit Notice & Semporna Dive Center Hydrographic Log Audit","zh-Hant":"沙巴公園局每日上島配額公告與仙本那潛店實測水文記錄核驗","ja":"サバ州立公園日次許可枠公示およびセンポルナ現地ダイブセンター海況記録確認","ko":"사바 공원청 일일 입도 정원 공지 및 셈포르나 다이브센터 실측 수문 기록 대조"}},"translations":{"zh-CN":"source","en":"reviewed","zh-Hant":"reviewed","ja":"reviewed","ko":"reviewed"},"country":"malaysia","region":"sabah","regionName":{"zh-CN":"马来西亚沙巴·仙本那","en":"Sabah · Semporna","zh-Hant":"馬來西亞沙巴·仙本那","ja":"マレーシア・サバ州センポルナ","ko":"말레이시아 사바주 셈포르나"},"name":{"zh-CN":"诗巴丹岛海洋公园","en":"Sipadan Island Marine Park","zh-Hant":"詩巴丹島海洋公園","ja":"シパダン島海洋公園","ko":"시파단섬 해양공원"},"summary":{"zh-CN":"位于西里伯斯海大陆架边缘的火山孤岛礁盘，离岸数米即垂直跌落至约600米深海海沟，现设12处峭壁潜点并实行每日实名配额入园制度。","en":"An oceanic volcanic pinnacle rising from a 600 m drop-off in the Celebes Sea, offering 12 wall dive sites regulated under a strict daily named-permit quota.","zh-Hant":"位於西里伯斯海大陸架邊緣的火山孤島礁盤，離岸數米即垂直跌落至約600米深海海溝，現設12處峭壁潛點並實行每日實名配額入園制度。","ja":"セレベス海の大陸棚縁辺にそびえる孤立礁で、岸から数メートルで水深約600mまで落ち込むドロップオフに12のウォールポイントが点在し、日次定員許可制で管理されています。","ko":"셀레베스해 대륙붕 가장자리에 솟은 화산 고립초로 해안에서 수 미터만 나가도 수심 약 600m 해구로 수직 하강하며, 일일 실명 허가제로 운영되는 12개 월 다이빙 포인트를 갖추고 있습니다."},"coords":{"lat":4.1147,"lng":118.6288},"stats":{"maxDepthM":40,"visibilityM":30,"diveSites":12},"waterTempC":{"min":27,"max":30},"currentLevel":"strong","certLevel":"aow","entryType":["speedboat","back-roll"],"season":{"open":4,"close":11},"nightDiving":false,"marineNote":{"zh-CN":"白鳍礁鲨停驻点（Barracuda Point）常见大群海狼风暴与隆头鹦哥鱼列队，龟冢及南角峭壁常年栖息绿海龟与玳瑁。","en":"Barracuda Point regularly hosts swirling chevron barracuda schools and bumphead parrotfish patrols, while green and hawksbill turtles rest along South Point ledges.","zh-Hant":"白鰭礁鯊停駐點（Barracuda Point）常見大群海狼風暴與隆頭鸚哥魚列隊，龜塚及南角峭壁常年棲息綠海龜與玳瑁。","ja":"バラクーダポイントではブラックフィンバラクーダの群れやカンムリブダイの行進が見られ、サウスポイントの棚にはアオウミガメとタイマイが通年棲息しています。","ko":"바라쿠다 포인트에서는 대규모 꼬치고기 무리와 범프헤드 패럿피시 행렬이 자주 관찰되며, 사우스 포인트 절벽 선반에는 푸른바다거북과 매부리바다거북이 연중 서식합니다."},"highlights":[{"zh-CN":"仙本那或马布岛快艇约45分钟抵达，岛上无住宿设施以保护海龟产卵滩","en":"Reached in 45 min by speedboat from Semporna or Mabul; overnight stays on the island are closed to protect turtle nesting beaches","zh-Hant":"仙本那或馬布島快艇約45分鐘抵達，島上無住宿設施以保護海龜產卵灘","ja":"センポルナまたはマブル島からスピードボートで約45分、ウミガメ産卵浜保護のため島内宿泊施設は非設置","ko":"셈포르나 또는 마불섬에서 쾌속정으로 약 45분 소요되며 바다거북 산란지 보호를 위해 섬 내 숙박 시설은 운영하지 않음"},{"zh-CN":"每日限额发放潜水许可证，需提前通过持牌潜店提交护照与AOW证书编号","en":"Daily dive permits are capped; passport details and AOW certification numbers must be submitted in advance via licensed operators","zh-Hant":"每日限額發放潛水許可證，需提前通過持牌潛店提交護照與AOW證書編號","ja":"1日あたりの入域許可枠が定められており、認定ダイブショップ経由で旅券とAOW番号の事前申請が必要","ko":"일일 입수 허가 인원이 제한되어 있어 인가된 다이브샵을 통해 여권과 AOW 자격 번호를 사전에 접수해야 함"}],"faq":[{"q":{"zh-CN":"诗巴丹海洋公园可以安排夜潜吗？","en":"Is night diving permitted inside Sipadan Island Marine Park?","zh-Hant":"詩巴丹海洋公園可以安排夜潛嗎？","ja":"シパダン島海洋公園内でナイトダイビングは可能ですか？","ko":"시파단섬 해양공원 안에서 야간 다이빙이 가능한가요?"},"a":{"zh-CN":"根据沙巴公园局规定，所有潜水船须在每日15:00前离岛，诗巴丹本岛不开放夜潜，夜潜通常安排在马布岛或卡帕莱礁盘。","en":"Sabah Parks regulations require all boats to depart by 15:00 daily; night dives are not held at Sipadan and are instead scheduled around Mabul or Kapalai reefs.","zh-Hant":"根據沙巴公園局規定，所有潛水船須在每日15:00前離島，詩巴丹本島不開放夜潛，夜潛通常安排在馬布島或卡帕萊礁盤。","ja":"サバ州立公園の規定により全ボートが毎日15:00までに離島するため本島でのナイトダイブは行われず、マブル島やカパライ周辺で実施されます。","ko":"사바 공원청 규정에 따라 모든 다이빙 보트는 매일 15:00 이전에 철수해야 하므로 본섬 야간 다이빙은 불가하며 주로 마불섬이나 카팔라이 리프에서 진행됩니다."}}]},{"slug":"palau-blue-corner","status":"published","sourceType":"editorial","sample":true,"featured":true,"updatedAt":"2026-11-22","verification":{"verifiedBy":"diving-editorial","verifiedAt":"2026-11-19","source":{"zh-CN":"科罗尔州海洋保护许可证条例与外礁潜导潮汐日志核验","en":"Koror State Rock Islands Permit Ordinance & Outer Reef Tide Log Audit","zh-Hant":"科羅爾州海洋保護許可證條例與外礁潛導潮汐日誌核驗","ja":"コロール州ロックアイランド許可条例および外洋リーフ潮流ログ確認","ko":"코로르주 록아일랜드 허가 조례 및 외초 조류 로그 검증"}},"translations":{"zh-CN":"source","en":"reviewed","zh-Hant":"reviewed","ja":"reviewed","ko":"reviewed"},"country":"palau","region":"koror","regionName":{"zh-CN":"帕劳·科罗尔外礁","en":"Palau · Koror Outer Reef","zh-Hant":"帛琉·科羅爾外礁","ja":"パラオ・コロール外洋リーフ","ko":"팔라우 코로르 외초"},"name":{"zh-CN":"帕劳蓝角与德国水道潜区","en":"Palau Blue Corner & German Channel","zh-Hant":"帛琉藍角與德國水道潛區","ja":"パラオ・ブルーコーナー＆ジャーマンチャネル","ko":"팔라우 블루코너 & 저먼채널"},"summary":{"zh-CN":"位于科罗尔西南外堡礁迎流转角与人工航道交汇水域，富含上升洋流营养盐，常年使用流钩固定在15至22米礁盘边缘观察洄游鱼群。","en":"Positioned where southwest outer barrier reef corners meet tidal channels off Koror, nutrient-rich upwellings allow divers to clip reef hooks along 15–22 m ledges to watch pelagic schools.","zh-Hant":"位於科羅爾西南外堡礁迎流轉角與人工航道交匯水域，富含上升洋流營養鹽，常年使用流鉤固定在15至22米礁盤邊緣觀察洄游魚群。","ja":"コロール南西の外堡礁コーナーと水路が交差する湧昇流域に位置し、水深15〜22mの棚縁でカレントフックを掛けて回遊魚の群れを観察するスタイルが定着しています。","ko":"코로르 남서쪽 외보초 모서리와 수로가 만나는 용승 해역에 자리하며, 수심 15~22m 리프 가장자리에서 리프훅을 걸고 회유성 어군을 관찰하는 방식으로 운영됩니다."},"coords":{"lat":7.1369,"lng":134.2211},"stats":{"maxDepthM":35,"visibilityM":32,"diveSites":18},"waterTempC":{"min":28,"max":30},"currentLevel":"strong","certLevel":"aow-50","entryType":["speedboat","liveaboard","negative-entry"],"season":{"open":11,"close":5},"nightDiving":true,"marineNote":{"zh-CN":"蓝角迎流面常见灰礁鲨、苏眉鱼与六带鲹群巡游，德国水道清洁站12月至次年4月高频出现阿氏前口蝠鲼。","en":"Grey reef sharks, Napoleon wrasse, and bigeye trevally patrol Blue Corner's current edge, while reef manta rays frequent German Channel cleaning stations from December to April.","zh-Hant":"藍角迎流面常見灰礁鯊、蘇眉魚與六帶鰺群巡遊，德國水道清潔站12月至次年4月高頻出現阿氏前口蝠鱝。","ja":"ブルーコーナーの潮上側ではグレイリーフシャークやナポレオンフィッシュ、ギンガメアジの群れが回遊し、12〜4月はジャーマンチャネルのクリーニングステーションにナンヨウマンタが集まります。","ko":"블루코너 조류 정면에서는 그레이 리프샤크와 나폴레옹 피시, 빅아이 트레발리 무리가 순회하며, 12월부터 4월까지는 저먼채널 클리닝 스테이션에 만타가오리가 자주 출현합니다."},"highlights":[{"zh-CN":"标配礁石流钩与高可视度象拔（SMB），部分迎流潜次采用负浮力直接下潜","en":"Reef hooks and surface marker buoys (SMBs) are standard gear, with negative-buoyancy entries used during strong incoming tides","zh-Hant":"標配礁石流鉤與高可視度象拔（SMB），部分迎流潛次採用負浮力直接下潛","ja":"カレントフックとSMB携行が標準装備となっており、上げ潮時はネガティブエントリーを行う場合があります","ko":"리프훅과 수면표시부이(SMB)가 기본 장비로 요구되며, 조류가 강한 시간대에는 네거티브 입수를 시행함"},{"zh-CN":"可选科罗尔快艇当日往返（单程约55分钟）或7晚外礁船宿航线","en":"Accessible via 55-minute day speedboats from Koror marinas or 7-night outer-reef liveaboard itineraries","zh-Hant":"可選科羅爾快艇當日往返（單程約55分鐘）或7晚外礁船宿航線","ja":"コロール港から片道約55分のデイトリップ快走艇、または7泊の外洋クルーズ船から選択可能","ko":"코로르 선착장에서 편도 약 55분 당일 쾌속정 또는 7박 외초 리브어보드 일정 중 선택 가능"}],"faq":[{"q":{"zh-CN":"前往蓝角潜水是否可以使用普通金属流钩？","en":"Are standard reef hooks allowed at Palau Blue Corner?","zh-Hant":"前往藍角潛水是否可以使用普通金屬流鉤？","ja":"ブルーコーナーでは一般的なカレントフックを使用できますか？","ko":"블루코너 다이빙 시 일반 금속 리프훅을 사용할 수 있나요?"},"a":{"zh-CN":"允许使用单钩挂在裸露死礁岩缝，严禁钩挂活体珊瑚，潜导会在下水前简报指定挂钩平台区域。","en":"Single reef hooks may be anchored only on bare dead rock ledges and never on live coral; guides brief designated hooking zones before splash-in.","zh-Hant":"允許使用單鉤掛在裸露死礁岩縫，嚴禁鉤掛活體珊瑚，潛導會在下水前簡報指定掛鉤平台區域。","ja":"露出した死サンゴ岩へのシングルフック固定のみ認められ、生きたサンゴへの使用は厳禁です。潜降前にガイドが固定エリアを指定します。","ko":"노출된 죽은 암반 틈새에만 싱글 훅 고정이 허용되며 살아있는 산호에 거는 행위는 엄격히 금지됩니다. 입수 전 가이드가 지정 구역을 브리핑합니다."}}]},{"slug":"komodo","status":"published","sourceType":"editorial","sample":true,"featured":false,"updatedAt":"2026-11-22","verification":{"verifiedBy":"diving-editorial","verifiedAt":"2026-11-18","source":{"zh-CN":"纳闽巴霍港务航行通告与科莫多保护区南北航线潜点手册核验","en":"Labuan Bajo Port Authority Advisories & Komodo North-South Dive Site Manual Audit","zh-Hant":"納閩巴霍港務航行通告與科莫多保護區南北航線潛點手冊核驗","ja":"ラブアンバジョ港湾局航行通達およびコモド南北ルートポイントマニュアル確認","ko":"라부안바조 항만청 항행 공고 및 코모도 남북 항로 포인트 매뉴얼 대조"}},"translations":{"zh-CN":"source","en":"reviewed","zh-Hant":"reviewed","ja":"reviewed","ko":"reviewed"},"country":"indonesia","region":"labuan-bajo","regionName":{"zh-CN":"印度尼西亚·纳闽巴霍","en":"Indonesia · Labuan Bajo","zh-Hant":"印度尼西亞·納閩巴霍","ja":"インドネシア・ラブアンバジョ","ko":"인도네시아 라부안바조"},"name":{"zh-CN":"科莫多海峡海洋保护潜区","en":"Komodo Strait Marine Reserve","zh-Hant":"科莫多海峽海洋保護潛區","ja":"コモド海峡海洋保護エリア","ko":"코모도 해협 해양보호 다이빙 구역"},"summary":{"zh-CN":"坐落于太平洋与印度洋潮汐交换通道，北部海域水温26至28°C以暗礁鱼群见长，南部上升流区水温22至25°C兼具蝠鲼清洁站与微距黑沙潜点。","en":"Straddling the Indonesian Throughflow between the Pacific and Indian Oceans, pairing 26–28°C northern seamounts with cooler 22–25°C southern manta stations and black-sand muck sites.","zh-Hant":"坐落於太平洋與印度洋潮汐交換通道，北部海域水溫26至28°C以暗礁魚群見長，南部上升流區水溫22至25°C兼具蝠鱝清潔站與微距黑沙潛點。","ja":"太平洋とインド洋の潮流が交わる海峡に位置し、水温26〜28°Cの北部根待ちポイントと水温22〜25°Cの南部マンタステーション・黒砂マクロポイントを併せ持ちます。","ko":"태평양과 인도양 조류가 교차하는 해협에 위치하여 수온 26~28°C 북부 수중봉 포인트와 수온 22~25°C 남부 만타 클리닝 스테이션·검은 모래 마크 포인트를 모두 갖추고 있습니다."},"coords":{"lat":-8.5522,"lng":119.4883},"stats":{"maxDepthM":38,"visibilityM":25,"diveSites":28},"waterTempC":{"min":22,"max":28},"currentLevel":"strong","certLevel":"aow","entryType":["liveaboard","day-boat","zodiac"],"season":{"open":4,"close":11},"nightDiving":true,"marineNote":{"zh-CN":"蝠鲼角（Manta Point）碎石水道全年可见蝠鲼觅食与清洁，水晶石与城堡礁暗流交汇处聚集大群乌尾鮗、巨型鲹与白鳍礁鲨。","en":"Manta Point's rubble channel hosts feeding and cleaning reef mantas year-round, while Castle and Crystal Rocks attract fusilier clouds, giant trevally, and whitetip reef sharks.","zh-Hant":"蝠鱝角（Manta Point）碎石水道全年可見蝠鱝覓食與清潔，水晶石與城堡礁暗流交匯處聚集大群烏尾鮗、巨型鰺與白鰭礁鯊。","ja":"マンタポイントの礫底水路では通年マンタの捕食とクリーニングが見られ、キャッスルロックやクリスタルロックにはタカサゴの大群やロウニンアジが集まります。","ko":"만타 포인트 자갈 수로에서는 연중 만타가오리의 섭식과 클리닝이 관찰되며, 캐슬록과 크리스탈록 암초 주변에는 푸질리어 무리와 자이언트 트레발리가 모입니다."},"highlights":[{"zh-CN":"南北温差显著，船宿行程建议携带5毫米湿衣及头套应对南部低温上升流","en":"Noticeable north-south thermoclines; a 5 mm wetsuit with hood is recommended when diving cooler southern upwellings","zh-Hant":"南北溫差顯著，船宿行程建議攜帶5毫米濕衣及頭套應對南部低溫上升流","ja":"南北で水温差が大きいため、南部の冷たい湧昇流エリアでは5mmウェットスーツとフードの着用を推奨","ko":"남북 수온 편차가 뚜렷하므로 남부 저수온 용승 구역 다이빙 시 5mm 웻수트와 후드 착용을 권장함"},{"zh-CN":"纳闽巴霍科莫多机场（LBJ）每日有多班雅加达与巴厘岛直航航班，距船宿登船码头约15分钟车程","en":"Labuan Bajo Komodo Airport (LBJ) connects directly with Jakarta and Bali flights, 15 minutes from the liveaboard harbor","zh-Hant":"納閩巴霍科莫多機場（LBJ）每日有多班雅加達與峇里島直航航班，距船宿登船碼頭約15分鐘車程","ja":"ラブアンバジョ空港（LBJ）へジャカルタ・バリ島から毎日直行便が運航し、港まで車で約15分","ko":"라부안바조 코모도 공항(LBJ)에 자카르타·발리 직항편이 매일 운항하며 승선 항구까지 차량으로 약 15분 소요됨"}],"faq":[{"q":{"zh-CN":"科莫多旱季与雨季的航线重点有什么区别？","en":"How do dry-season and wet-season dive routes differ in Komodo?","zh-Hant":"科莫多旱季與雨季的航線重點有什麼區別？","ja":"コモドの乾季と雨季でダイビングルートはどう変わりますか？","ko":"코모도의 건기와 우기 다이빙 항로는 어떻게 다른가요?"},"a":{"zh-CN":"4月至11月旱季风浪平稳，主走北部水晶石、中部蝠鲼角路线；12月至次年3月南风减弱，适合深入南部卡尼巴尔礁区域。","en":"From April to November calm seas favor northern seamounts and central Manta Point, while December to March brings calmer southern swells ideal for Cannibal Rock.","zh-Hant":"4月至11月旱季風浪平穩，主走北部水晶石、中部蝠鱝角路線；12月至次年3月南風減弱，適合深入南部卡尼巴爾礁區域。","ja":"4〜11月の乾季は北部の根や中部マンタポイントが穏やかで、12〜3月は南うねりが収まり南部カニバルロック方面へ入りやすくなります。","ko":"4~11월 건기에는 해황이 잔잔해 북부 수중봉과 중부 만타 포인트 위주로 운항하며, 12~3월에는 남쪽 너울이 잦아들어 남부 카니발록 일대 진입이 수월합니다."}}]}]}],"attributeTypes":["number","string","boolean","enum","range","localizedString","list"],"attributeFormats":["plain","integer","decimal","percent","currencyCny","monthRange","coords","booleanBadge","enumLabel"]}}